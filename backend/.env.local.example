# Copy to .env.local for `npm start` on a laptop (never committed). The same names are
# set as environment variables on Render. Without MONGODB_URI the API keeps data in memory.
PORT=3000

# MongoDB Atlas (docs/mongodb.md): cloud.mongodb.com > your cluster > Connect > Drivers,
# and allow your IP under Network Access. Or a local server: mongodb://127.0.0.1:27017
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# MONGODB_DB=safetouch

# Real emails (Brevo): the sender must be verified there.
# MAIL_PROVIDER=brevo
# MAIL_FROM=you@example.org
# MAIL_API_KEY=

# Text the verification code too (docs/sms.md). Brevo SMS is paid by credit.
# SMS_PROVIDER=brevo      (console prints the texts; off or unset sends none)
# SMS_SENDER=SafeTouch
# Africa's Talking (Rwanda): SMS_PROVIDER=africastalking, then
# AT_USERNAME=...   AT_API_KEY=...   AT_SANDBOX=1 (free simulator while testing)
