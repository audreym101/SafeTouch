# Copy to .env.local for `npm start` on a laptop (never committed, never deployed).
# Without MONGODB_URI or any of the Firestore settings below, the API keeps data in memory.
PORT=3000

# Use MongoDB (wins over Firestore when set). MongoDB Atlas: cloud.mongodb.com >
# your cluster > Connect > Drivers, and allow your IP under Network Access.
# Or a local server: mongodb://127.0.0.1:27017
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# MONGODB_DB=safetouch

# Use the real Cloud Firestore: Firebase console > Project settings > Service
# accounts > Generate new private key. Keep the file outside the repo.
# GOOGLE_APPLICATION_CREDENTIALS=C:/Users/you/keys/safetouch-service-account.json

# Or use the Firestore emulator (`npm run emulate` in another terminal):
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# GOOGLE_CLOUD_PROJECT=demo-safetouch

# Only to send real emails from the laptop (the deployed function uses the secret).
# MAIL_API_KEY=

# Text the verification code too (docs/sms.md). Brevo SMS is paid by credit.
# SMS_PROVIDER=brevo      (console prints the texts; off or unset sends none)
# SMS_SENDER=SafeTouch
