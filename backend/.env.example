# Copy to .env (never commit it). It is deployed with the Cloud Function, so it
# must not hold PORT, FUNCTION_* or FIREBASE_* names (Firebase reserves them) or
# any secret. The email API key is a Firebase secret instead:
#   firebase functions:secrets:set MAIL_API_KEY

# Where the function runs. europe-west1 (Belgium) is the closest region to Rwanda.
API_REGION=europe-west1

# Parental consent emails (6-digit code + copy of the consent). "console" writes
# the emails to the logs instead, which is enough for testing.
# MAIL_PROVIDER=brevo    (brevo.com: free tier, 300 emails a day)
# MAIL_PROVIDER=resend   (resend.com: free tier)
MAIL_PROVIDER=console
MAIL_FROM=safetouch@your-verified-domain.org
