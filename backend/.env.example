# Copy to .env (never commit .env). Without MONGODB_URI the API keeps data in memory.
PORT=3000
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=safetouch

# Parental consent emails (6-digit code + copy of the consent). Without a provider
# the emails are printed in this console, which is enough for testing.
# MAIL_PROVIDER=brevo    (brevo.com: free tier, 300 emails a day)
# MAIL_PROVIDER=resend   (resend.com: free tier)
MAIL_PROVIDER=console
MAIL_API_KEY=
MAIL_FROM=safetouch@your-verified-domain.org
