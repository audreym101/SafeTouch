# Copy to .env if you want (never commit it). Only settings that are safe to share go here:
# keys and passwords go in .env.local on a laptop, and in Render's environment variables online.

# Parental consent emails (6-digit code + copy of the consent). "console" prints
# the emails in the server log instead, which is enough for testing.
# MAIL_PROVIDER=brevo    (brevo.com: free tier, 300 emails a day)
# MAIL_PROVIDER=resend   (resend.com: free tier)
MAIL_PROVIDER=console
MAIL_FROM=safetouch@your-verified-domain.org
