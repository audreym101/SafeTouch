{
  "name": "safetouch-api",
  "version": "0.1.0",
  "description": "SafeTouch API: parental consent and optional anonymous progress, on Firebase (Cloud Functions + Firestore)",
  "main": "src/function.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test",
    "deploy": "firebase deploy --only functions,firestore:rules",
    "emulate": "firebase emulators:start --only functions,firestore"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "express": "^4.21.2",
    "firebase-admin": "^13.10.0",
    "firebase-functions": "^6.6.0"
  }
}
